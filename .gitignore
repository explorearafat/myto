node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
.claude/

# Myto app runtime state & generated plan artifacts (machine-local, never committed)
.sylor/
/plan.md
.vercel

# The Windows installer staged here by scripts/copy-electron-build.js — 133 MB and
# reproducible from npm run build, so committing it bloats history for everyone.
# dist/ (line 3) already covers the published copy; this covers the staging copy.
/public/electron/

# Third-party reference clone (OpenClaw, MIT) + local investigation/scratch docs.
# Studied to harden Myto; never committed or pushed (its code stays out of our tree).
/OpenClawSource/
/GAP_ANALYSIS.md
/NOTES.md
.myto/

# Local scratch: a demo project the `myto` CLI built, copied here only so the
# browser preview can serve it. Generated, never committed.
/.demo/

# Phantom entry: `nul` is a reserved Windows device name, so git's lstat on it
# always "succeeds" and reports an untracked `nul` even when no such file exists
# on disk. Ignore it so a stray shell redirect can never surface as a change.
/nul

# Local media work folders (large, machine-local; never committed)
/ForPhotoEditing/
/ForVideoEditing/

# Uploads staging area (runtime artifacts, not source)
/uploads/
