# /chat gateway configuration. Copy to `.env.local` for local dev (git-ignored), and set the same
# vars in your Vercel project (Settings → Environment Variables). None of these are exposed to the
# browser — they are read only by the server gateway (api/chat.ts / the Vite dev middleware).
#
# With no B_AI_KEYS set, /chat streams a canned offline reply (from the built-in knowledge base).
# With no UPSTASH_* set, the token quota is disabled (unlimited) — handy for local UI work.

# Upstream OpenAI-compatible provider.
B_AI_BASE_URL=https://api.b.ai/v1/
# Comma-separated API keys; requests fail over across them.
B_AI_KEYS=sk-xxxx,sk-yyyy,sk-zzzz
# Optional — the real model pool the two Oraculum facades route across.
B_AI_MODELS=hy3,mimo-v2.5,glm-5.3-flash,qwen3.8-flash

# Per-user token quota (Upstash Redis REST — create a free DB at upstash.com).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Quota tuning.
SYLOR_TOKEN_BUDGET=300000      # tokens per user per window
SYLOR_WINDOW_SECONDS=18000     # rolling window in seconds (5 hours)
SYLOR_MAX_OUTPUT_TOKENS=1536   # cap on each reply
