# /chat gateway configuration. Copy to `.env.local` for local dev (git-ignored), and set the same
# vars in your Vercel project (Settings → Environment Variables) if you want to change the defaults.
# None of these are exposed to the browser — they are read only by the server gateway
# (api/chat.ts / the Vite dev middleware).
#
# The gateway is a bring-your-own-key PROXY: it holds no upstream keys of its own. Each request
# carries the user's own base URL + API key + model (configured on the /authentication page and
# stored in Firestore), and the gateway forwards to that endpoint. So there is nothing to configure
# here for chat to work — these two vars are only optional tuning.

# Master switch for the read-only web tools (web_fetch / web_search / wiki_search). Default: on.
# Set to "0" or "false" to disable them.
SYLOR_TOOLS=1

# Cap on each reply's output tokens.
SYLOR_MAX_OUTPUT_TOKENS=1536
