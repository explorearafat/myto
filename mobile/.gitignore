# Firebase — the per-platform config files `flutterfire configure` drops in are kept out of git.
# NOTE: lib/firebase_options.dart is intentionally NOT ignored — the committed one is a
# hand-written stand-in carrying the *public* Web config so the project compiles out of the box;
# `flutterfire configure` overwrites it locally with real Android/iOS options (fine to keep local).
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Symbolication / obfuscation
app.*.symbols
app.*.map.json
